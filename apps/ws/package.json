{
  "name": "ws",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx esbuild ./src/index.ts --bundle --platform=node --outfile=dist/index.js --sourcemap",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "test": "tsc src/ai/minimax.ts src/ai/minimax.test.ts --target es2020 --module commonjs --esModuleInterop --strict --skipLibCheck --outDir dist-test && node --test dist-test/minimax.test.js"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "@repo/db": "*",
    "chess.js": "^1.0.0-beta.8",
    "dotenv": "^17.2.3",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.7.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.10",
    "prisma": "^5.12.1",
    "typescript": "^5.4.5"
  }
}
