WS_PORT=8080

# Database (must match packages/db and apps/backend)
DATABASE_URL="postgresql://user:password@localhost:5432/chess4nerds"

# Must be identical to the JWT_SECRET in apps/backend/.env
JWT_SECRET="change-me-to-a-long-random-string"

# Optional — when set, room broadcasts are relayed through Redis so additional
# WS replicas can re-broadcast to their own clients. Leave unset for single-node.
# REDIS_URL="redis://localhost:6379"
