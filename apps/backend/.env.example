# Server
PORT=3000
NODE_ENV=development

# Database (must match packages/db and apps/ws)
DATABASE_URL="postgresql://user:password@localhost:5432/chess4nerds"

# Auth secrets — use long random strings, never commit real values.
# JWT_SECRET must be identical to the one in apps/ws/.env.
JWT_SECRET="change-me-to-a-long-random-string"
COOKIE_SECRET="change-me-to-a-long-random-string"

# OAuth (optional) — leave blank to disable Google / GitHub login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where to redirect the user after a successful OAuth login
AUTH_REDIRECT_URL="http://localhost:5173"

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS="http://localhost:5173"

# Set to "true" to disable the guest-endpoint rate limiter (e.g. for load tests)
RATE_LIMIT_DISABLED=false
