# Node.js dependencies
node_modules/

# package-lock.json is generated per-platform. A Windows-generated lockfile
# omits Linux-only binaries (npm optional-deps bug, npm/cli#4828) and breaks
# Linux deploys, so each environment generates its own on `npm install`.
package-lock.json

